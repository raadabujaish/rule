{
  "rule_id": "b266eb03-7f05-4991-a944-529dba11a60c",
  "name": "Forcepoint DLP — High Severity Policy Match",
  "version": 1,
  "enabled": true,
  "interval": "1h",
  "from": "now-3900s",
  "to": "now",
  "description": "DLP High Severity",
  "tags": [
    "IRM",
    "QA"
  ],
  "author": [],
  "license": "",
  "threat": [],
  "investigation_fields": {
    "field_names": [
      "cef.extensions.loginName",
      "cef.extensions.sourceHost",
      "cef.extensions.sourceIp",
      "cef.extensions.destinationHosts",
      "cef.extensions.deviceAction",
      "cef.extensions.filename",
      "cef.extensions.deviceEventCategory",
      "cef.extensions.severityType",
      "message"
    ]
  },
  "related_integrations": [],
  "required_fields": [],
  "setup": "",
  "false_positives": [],
  "references": [],
  "risk_score": 73,
  "risk_score_mapping": [],
  "severity": "high",
  "severity_mapping": [],
  "output_index": "",
  "max_signals": 100,
  "exceptions_list": [],
  "actions": [],
  "meta": {
    "from": "5m",
    "kibana_siem_app_url": "https://jcb.scanwave.local:8008/app/security"
  },
  "type": "query",
  "language": "kuery",
  "index": [
    "logs-cef.log-*"
  ],
  "query": "",
  "filters": [
    {
      "meta": {
        "index": "8c504f4e-0d43-4eb8-a2cb-55a61f70b6cf",
        "type": "phrase",
        "disabled": false,
        "negate": false,
        "alias": null,
        "key": "cef.device.vendor",
        "params": {
          "query": "Forcepoint"
        }
      },
      "query": {
        "match_phrase": {
          "cef.device.vendor": "Forcepoint"
        }
      },
      "$state": {
        "store": "appState"
      }
    },
    {
      "meta": {
        "index": "8c504f4e-0d43-4eb8-a2cb-55a61f70b6cf",
        "type": "phrase",
        "disabled": false,
        "negate": false,
        "alias": null,
        "key": "cef.extensions.severityType",
        "params": {
          "query": "HIGH"
        }
      },
      "$state": {
        "store": "appState"
      },
      "query": {
        "match_phrase": {
          "cef.extensions.severityType": "HIGH"
        }
      }
    }
  ],
  "alert_suppression": {
    "group_by": [
      "cef.extensions.loginName"
    ],
    "duration": {
      "value": 4,
      "unit": "h"
    },
    "missing_fields_strategy": "doNotSuppress"
  }
}