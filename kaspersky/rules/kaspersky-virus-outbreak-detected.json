{
  "name": "Kaspersky — Virus Outbreak Detected",
  "tags": [
    "NBI-Endpoint",
    "Phase3",
    "Kaspersky-EDR"
  ],
  "interval": "5m",
  "enabled": true,
  "description": "Detects Kaspersky Security Center raising a Virus Outbreak — its own correlation that the same or many threats are detected across multiple endpoints in a short period, indicating malware spreading through the environment (worm/ransomware propagation).",
  "risk_score": 95,
  "severity": "critical",
  "note": "## Investigation\n1. Review the outbreak scope (affected hosts/threat) in Kaspersky Security Center.\n2. Identify patient-zero and the propagation vector.\n## Response\nContain affected network segments, accelerate signature/patch deployment, and initiate mass IR.",
  "output_index": "",
  "investigation_fields": {
    "field_names": [
      "cef.extensions.deviceCustomString1",
      "cef.extensions.filePath",
      "cef.extensions.deviceCustomString4",
      "cef.extensions.cs9",
      "cef.extensions.message",
      "destination.domain",
      "destination.user.name",
      "event.code",
      "cef.severity",
      "cef.name"
    ]
  },
  "author": [
    "raadabujaish"
  ],
  "false_positives": [],
  "from": "now-9m",
  "rule_id": "nbi-ksc-virus-outbreak",
  "max_signals": 100,
  "risk_score_mapping": [],
  "severity_mapping": [],
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0040",
        "name": "Impact",
        "reference": "https://attack.mitre.org/tactics/TA0040/"
      },
      "technique": [
        {
          "id": "T1486",
          "name": "Data Encrypted for Impact",
          "reference": "https://attack.mitre.org/techniques/T1486/"
        }
      ]
    }
  ],
  "to": "now",
  "references": [
    "https://attack.mitre.org/"
  ],
  "version": 1,
  "exceptions_list": [],
  "related_integrations": [],
  "required_fields": [],
  "setup": "",
  "type": "query",
  "language": "kuery",
  "index": [
    "logs-cef.log-*"
  ],
  "query": "observer.vendor:\"KasperskyLab\" and event.code:\"GNRL_EV_VIRUS_OUTBREAK\"",
  "actions": []
}