        "key": "query",
        "value": "{\"bool\":{\"filter\":[{\"bool\":{\"minimum_should_match\":1,\"should\":[{\"bool\":{\"minimum_should_match\":1,\"should\":[{\"wildcard\":{\"cef.extensions.message\":{\"value\":\"*Allow USB - CD*\"}}}]}},{\"bool\":{\"minimum_should_match\":1,\"should\":[{\"wildcard\":{\"cef.extensions.message\":{\"value\":\"*Allow USB*\"}}}]}},{\"bool\":{\"minimum_should_match\":1,\"should\":[{\"wildcard\":{\"cef.extensions.message\":{\"value\":\"*Allow CD*\"}}}]}}]}}],\"must\":[],\"must_not\":[],\"should\":[]}}"
      },
      "$state": {
        "store": "appState"
      },
      "query": {
        "bool": {
          "filter": [
            {
              "bool": {
                "minimum_should_match": 1,
                "should": [
                  {
                    "bool": {
                      "minimum_should_match": 1,
                      "should": [
                        {
                          "wildcard": {
                            "cef.extensions.message": {
