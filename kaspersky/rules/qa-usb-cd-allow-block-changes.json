                    "bool": {
                      "minimum_should_match": 1,
                      "should": [
                        {
                          "wildcard": {
                            "cef.extensions.message": {
                              "value": "*Allow USB*"
                            }
                          }
                        }
                      ]
                    }
                  },
                  {
                    "bool": {
                      "minimum_should_match": 1,
                      "should": [
                        {
                          "wildcard": {
                            "cef.extensions.message": {
                              "value": "*Allow CD*"
                            }
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "must": [],
          "must_not": [],
          "should": []
        }
