{
  "rule_id": "jcb-rec-interactive-terminal-spawned-via-perl",
  "name": "Linux — Interactive Terminal Spawned via Perl",
  "version": 1,
  "enabled": true,
  "interval": "5m",
  "from": "now-9m",
  "to": "now",
  "description": "Identifies when a terminal (tty) is spawned via Perl. Attackers may upgrade a simple reverse shell to a fully interactive tty after obtaining initial access to a host.",
  "tags": [
    "JCB",
    "Linux"
  ],
  "author": [
    "raadabujaish"
  ],
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0002",
        "name": "Execution",
        "reference": "https://attack.mitre.org/tactics/TA0002/"
      },
      "technique": [
        {
          "id": "T1059",
          "name": "Command and Scripting Interpreter",
          "reference": "https://attack.mitre.org/techniques/T1059/"
        }
      ]
    }
  ],
  "investigation_fields": {
    "field_names": [
      "host.name",
      "user.name",
      "user.id",
      "process.name",
      "process.executable",
      "process.args",
      "process.parent.name",
      "file.path",
      "event.action",
      "event.outcome",
      "message",
      "event.category",
      "host.os.type",
      "event.type"
    ]
  },
  "related_integrations": [],
  "required_fields": [],
  "setup": "",
  "false_positives": [],
  "references": [],
  "risk_score": 73,
  "risk_score_mapping": [],
  "severity": "high",
  "severity_mapping": [],
  "output_index": "",
  "max_signals": 100,
  "exceptions_list": [],
  "actions": [],
  "type": "query",
  "language": "kuery",
  "index": [
    "logs-auditd.log-*",
    "logs-auditd_manager.auditd-*"
  ],
  "query": "event.category:process and host.os.type:linux and event.type:(start or process_started) and process.name:perl and\n  process.args:(\"exec \\\"/bin/sh\\\";\" or \"exec \\\"/bin/dash\\\";\" or \"exec \\\"/bin/bash\\\";\")\n"
}