{
  "rule_id": "jcb-rec-potential-protocol-tunneling-via-earthworm",
  "name": "Linux — Potential Protocol Tunneling via EarthWorm",
  "version": 1,
  "enabled": true,
  "interval": "5m",
  "from": "now-9m",
  "to": "now",
  "description": "Identifies the execution of the EarthWorm tunneler. Adversaries may tunnel network communications to and from a victim system within a separate protocol to avoid detection and network filtering, or to enable access to otherwise unreachable systems.",
  "tags": [
    "JCB",
    "Linux"
  ],
  "author": [
    "raadabujaish"
  ],
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0011",
        "name": "Command and Control",
        "reference": "https://attack.mitre.org/tactics/TA0011/"
      },
      "technique": [
        {
          "id": "T1572",
          "name": "Protocol Tunneling",
          "reference": "https://attack.mitre.org/techniques/T1572/"
        }
      ]
    }
  ],
  "investigation_fields": {
    "field_names": [
      "host.name",
      "user.name",
      "user.id",
      "process.name",
      "process.executable",
      "process.args",
      "process.parent.name",
      "file.path",
      "event.action",
      "event.outcome",
      "message",
      "host.os.type",
      "event.type"
    ]
  },
  "related_integrations": [],
  "required_fields": [],
  "setup": "",
  "false_positives": [],
  "references": [
    "http://rootkiter.com/EarthWorm/",
    "https://decoded.avast.io/luigicamastra/apt-group-targeting-governmental-agencies-in-east-asia/"
  ],
  "risk_score": 47,
  "risk_score_mapping": [],
  "severity": "medium",
  "severity_mapping": [],
  "output_index": "",
  "max_signals": 100,
  "exceptions_list": [],
  "actions": [],
  "type": "eql",
  "language": "eql",
  "index": [
    "logs-auditd.log-*",
    "logs-auditd_manager.auditd-*"
  ],
  "query": "process where host.os.type == \"linux\" and event.type == \"start\" and\n process.args : \"-s\" and process.args : \"-d\" and process.args : \"rssocks\"\n"
}