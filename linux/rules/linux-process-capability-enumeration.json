{
  "rule_id": "jcb-rec-process-capability-enumeration",
  "name": "Linux — Process Capability Enumeration",
  "version": 1,
  "enabled": true,
  "interval": "5m",
  "from": "now-9m",
  "to": "now",
  "description": "Identifies recursive process capability enumeration of the entire filesystem through the getcap command. Malicious users may manipulate identified capabilities to gain root privileges.",
  "tags": [
    "JCB",
    "Linux"
  ],
  "author": [
    "raadabujaish"
  ],
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0007",
        "name": "Discovery",
        "reference": "https://attack.mitre.org/tactics/TA0007/"
      },
      "technique": [
        {
          "id": "T1057",
          "name": "Process Discovery",
          "reference": "https://attack.mitre.org/techniques/T1057/"
        }
      ]
    }
  ],
  "investigation_fields": {
    "field_names": [
      "host.name",
      "user.name",
      "user.id",
      "process.name",
      "process.executable",
      "process.args",
      "process.parent.name",
      "file.path",
      "event.action",
      "event.outcome",
      "message",
      "host.os.type",
      "event.type",
      "process.args_count"
    ]
  },
  "related_integrations": [],
  "required_fields": [],
  "setup": "",
  "false_positives": [],
  "references": [],
  "risk_score": 21,
  "risk_score_mapping": [],
  "severity": "low",
  "severity_mapping": [],
  "output_index": "",
  "max_signals": 100,
  "exceptions_list": [],
  "actions": [],
  "type": "eql",
  "language": "eql",
  "index": [
    "logs-auditd.log-*",
    "logs-auditd_manager.auditd-*"
  ],
  "query": "process where host.os.type == \"linux\" and event.type == \"start\" and event.action in (\"exec\", \"exec_event\") and\nprocess.name == \"getcap\" and process.args == \"-r\" and process.args == \"/\" and process.args_count == 3 and\nuser.id != \"0\"\n"
}