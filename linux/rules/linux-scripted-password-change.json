{
  "name": "Linux — Scripted Password Change (chpasswd)",
  "tags": [
    "NBI-Endpoint",
    "Phase3",
    "Linux-auditd"
  ],
  "interval": "5m",
  "enabled": true,
  "description": "Detects execution of chpasswd, which sets account passwords non-interactively from a script or pipe — used by attackers to change or reset local account passwords for persistence or account takeover.",
  "risk_score": 47,
  "severity": "medium",
  "note": "## Investigation\n1. `user.name` ran chpasswd on `host.name`.\n2. Identify which account(s) had passwords changed.\n## Response\nVerify authorisation; if malicious, reset affected accounts and investigate.",
  "output_index": "",
  "investigation_fields": {
    "field_names": [
      "process.executable",
      "process.args",
      "process.name",
      "process.parent.executable",
      "user.name",
      "host.name"
    ]
  },
  "author": [
    "raadabujaish"
  ],
  "false_positives": [],
  "from": "now-9m",
  "rule_id": "nbi-lnx-scripted-passwd-change",
  "max_signals": 100,
  "risk_score_mapping": [],
  "severity_mapping": [],
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0003",
        "name": "Persistence",
        "reference": "https://attack.mitre.org/tactics/TA0003/"
      },
      "technique": [
        {
          "id": "T1098",
          "name": "Account Manipulation",
          "reference": "https://attack.mitre.org/techniques/T1098/"
        }
      ]
    }
  ],
  "to": "now",
  "references": [
    "https://attack.mitre.org/"
  ],
  "version": 1,
  "exceptions_list": [],
  "related_integrations": [],
  "required_fields": [],
  "setup": "",
  "type": "query",
  "language": "kuery",
  "index": [
    "logs-auditd.log-*",
    "logs-auditd_manager.auditd-*"
  ],
  "query": "event.category:\"process\" and process.name:\"chpasswd\"",
  "actions": []
}