{
  "rule_id": "jcb-rec-sudoers-file-modification",
  "name": "Linux — Sudoers File Modification",
  "version": 1,
  "enabled": true,
  "interval": "5m",
  "from": "now-9m",
  "to": "now",
  "description": "A sudoers file specifies the commands that users or groups can run and from which terminals. Adversaries can take advantage of these configurations to execute commands as other users or spawn processes with higher privileges.",
  "tags": [
    "JCB",
    "Linux"
  ],
  "author": [
    "raadabujaish"
  ],
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0004",
        "name": "Privilege Escalation",
        "reference": "https://attack.mitre.org/tactics/TA0004/"
      },
      "technique": [
        {
          "id": "T1548",
          "name": "Abuse Elevation Control Mechanism",
          "reference": "https://attack.mitre.org/techniques/T1548/",
          "subtechnique": [
            {
              "id": "T1548.003",
              "name": "Sudo and Sudo Caching",
              "reference": "https://attack.mitre.org/techniques/T1548/003/"
            }
          ]
        }
      ]
    }
  ],
  "investigation_fields": {
    "field_names": [
      "host.name",
      "user.name",
      "user.id",
      "process.name",
      "process.executable",
      "process.args",
      "process.parent.name",
      "file.path",
      "event.action",
      "event.outcome",
      "message",
      "event.category",
      "event.type"
    ]
  },
  "related_integrations": [],
  "required_fields": [],
  "setup": "",
  "false_positives": [],
  "references": [],
  "risk_score": 47,
  "risk_score_mapping": [],
  "severity": "medium",
  "severity_mapping": [],
  "output_index": "",
  "max_signals": 100,
  "exceptions_list": [],
  "actions": [],
  "type": "new_terms",
  "query": "event.category:file and event.type:change and file.path:(/etc/sudoers* or /private/etc/sudoers*) and\nnot process.name:(dpkg or platform-python or puppet or yum or dnf) and \nnot process.executable:(/opt/chef/embedded/bin/ruby or /opt/puppetlabs/puppet/bin/ruby or /usr/bin/dockerd)\n",
  "new_terms_fields": [
    "host.id",
    "process.executable",
    "file.path"
  ],
  "history_window_start": "now-7d",
  "index": [
    "logs-auditd.log-*",
    "logs-auditd_manager.auditd-*"
  ],
  "language": "kuery"
}