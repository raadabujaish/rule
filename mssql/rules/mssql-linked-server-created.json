{
  "name": "MS SQL — Linked Server Created (Lateral Movement)",
  "tags": [
    "NBI-Database",
    "Phase3",
    "MS-SQL-Server"
  ],
  "interval": "5m",
  "enabled": true,
  "description": "Detects creation of a SQL Server linked server or linked-server login, which establishes a trust to another database instance — abused for lateral movement, cross-server command execution and data access.",
  "risk_score": 73,
  "severity": "high",
  "note": "## Investigation\n1. Identify the remote server target and the credentials configured.\n2. Confirm the linked server is authorised.\n## Response\nRemove unauthorised linked servers; investigate for cross-server abuse.",
  "output_index": "",
  "investigation_fields": {
    "field_names": [
      "sqlserver.audit.statement",
      "sqlserver.audit.server_principal_name",
      "sqlserver.audit.session_server_principal_name",
      "sqlserver.audit.database_name",
      "sqlserver.audit.client_ip",
      "sqlserver.audit.application_name",
      "sqlserver.audit.host_name",
      "event.action",
      "host.name",
      "user.name"
    ]
  },
  "author": [
    "raadabujaish"
  ],
  "false_positives": [],
  "from": "now-9m",
  "rule_id": "nbi-sql-linked-server",
  "max_signals": 100,
  "risk_score_mapping": [],
  "severity_mapping": [],
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0008",
        "name": "Lateral Movement",
        "reference": "https://attack.mitre.org/tactics/TA0008/"
      },
      "technique": [
        {
          "id": "T1210",
          "name": "Exploitation of Remote Services",
          "reference": "https://attack.mitre.org/techniques/T1210/"
        }
      ]
    }
  ],
  "to": "now",
  "references": [
    "https://attack.mitre.org/",
    "https://learn.microsoft.com/en-us/sql/relational-databases/security/auditing/"
  ],
  "version": 1,
  "exceptions_list": [],
  "related_integrations": [],
  "required_fields": [],
  "setup": "",
  "type": "query",
  "language": "kuery",
  "index": [
    "logs-microsoft_sqlserver.audit-*"
  ],
  "query": "sqlserver.audit.statement:(\"sp_addlinkedserver\" or \"sp_addlinkedsrvlogin\")",
  "actions": []
}