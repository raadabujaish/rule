        "type": "custom",
        "disabled": false,
        "negate": false,
        "alias": null,
        "key": "query",
        "value": "{\"bool\":{\"should\":[{\"bool\":{\"must\":[],\"filter\":[{\"match_phrase\":{\"message\":\"Connection_Allowed\"}}],\"should\":[],\"must_not\":[]}},{\"bool\":{\"must\":[],\"filter\":[{\"match_phrase\":{\"message\":\"Connecton_Refused\"}}],\"should\":[],\"must_not\":[]}},{\"bool\":{\"must\":[],\"filter\":[{\"bool\":{\"must\":[],\"filter\":[{\"match_phrase\":{\"message\":\"Connection_Closed\"}},{\"match_phrase\":{\"tags\":\"ForcePointv8\"}}],\"should\":[],\"must_not\":[]}}],\"should\":[],\"must_not\":[]}}],\"minimum_should_match\":1}}"
      },
      "$state": {
        "store": "appState"
      },
      "query": {
        "bool": {
          "should": [
            {
              "bool": {
                "must": [],
                "filter": [
                  {
                    "match_phrase": {
                      "message": "Connection_Allowed"
                    }
                  }
                ],
                "should": [],
                "must_not": []
