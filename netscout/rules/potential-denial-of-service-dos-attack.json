                            "message": "Connection_Closed"
                          }
                        },
                        {
                          "match_phrase": {
                            "tags": "ForcePointv8"
                          }
                        }
                      ],
                      "should": [],
                      "must_not": []
                    }
                  }
                ],
                "should": [],
                "must_not": []
