{
  "rule_id": "jcb-o365-password-spray",
  "name": "O365 — Password Spraying: One Source Failing Against Many Accounts",
  "version": 1,
  "enabled": true,
  "interval": "15m",
  "from": "now-60m",
  "to": "now",
  "description": "One source IP with failed logins against ≥8 distinct O365 accounts in 45 minutes, excluding the bank egress NAT (94.249.88.0/24 — internal users all appear from it). timestamp_override handles the o365 API ingest lag that blinded earlier rules.",
  "tags": [
    "JCB",
    "Detection-QA-2026-08",
    "Office 365"
  ],
  "author": [
    "JCB Detection Engineering"
  ],
  "license": "internal",
  "threat": [],
  "investigation_fields": {
    "field_names": [
      "source.ip",
      "user.name",
      "event.action",
      "o365.audit.LogonError",
      "o365.audit.UserId",
      "o365.audit.ResultStatus"
    ]
  },
  "related_integrations": [],
  "required_fields": [],
  "setup": "",
  "false_positives": [],
  "references": [],
  "risk_score": 73,
  "risk_score_mapping": [],
  "severity": "high",
  "severity_mapping": [],
  "timestamp_override": "event.ingested",
  "output_index": "",
  "max_signals": 100,
  "exceptions_list": [],
  "actions": [],
  "type": "threshold",
  "language": "kuery",
  "index": [
    "logs-o365.audit-*"
  ],
  "query": "event.dataset:\"o365.audit\" and event.action:\"UserLoginFailed\" and not source.ip:\"94.249.88.0/24\"",
  "threshold": {
    "field": [
      "source.ip"
    ],
    "value": 8,
    "cardinality": [
      {
        "field": "user.name",
        "value": 8
      }
    ]
  }
}