{
  "rule_id": "c0535965-e6a2-4726-bb72-2c10d0224e4f",
  "name": " Sysmon Detection Alerts",
  "version": 1,
  "enabled": true,
  "interval": "10m",
  "from": "now-1200s",
  "to": "now",
  "description": " Sysmon Detection Alerts",
  "tags": [],
  "author": [],
  "license": "",
  "threat": [],
  "investigation_fields": {
    "field_names": [
      "kibana.alert.rule.name",
      "kibana.alert.severity",
      "host.name",
      "user.name",
      "source.ip",
      "destination.ip",
      "message"
    ]
  },
  "related_integrations": [],
  "required_fields": [],
  "setup": "",
  "false_positives": [],
  "references": [],
  "risk_score": 73,
  "risk_score_mapping": [],
  "severity": "high",
  "severity_mapping": [],
  "output_index": "",
  "max_signals": 100,
  "exceptions_list": [],
  "actions": [],
  "meta": {
    "from": "10m",
    "kibana_siem_app_url": "https://jcb.scanwave.local:8008/app/security"
  },
  "type": "query",
  "language": "kuery",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    ".alerts-security.alerts-default"
  ],
  "query": "",
  "filters": [
    {
      "meta": {
        "index": "3ae2a6c1-0dbe-4ea3-b1ed-8bee2d5ef04e",
        "type": "phrase",
        "disabled": false,
        "negate": false,
        "alias": null,
        "key": "kibana.alert.rule.tags",
        "params": {
          "query": "Data Source: Sysmon Only"
        }
      },
      "query": {
        "match_phrase": {
          "kibana.alert.rule.tags": "Data Source: Sysmon Only"
        }
      },
      "$state": {
        "store": "appState"
      }
    },
    {
      "meta": {
        "index": "3ae2a6c1-0dbe-4ea3-b1ed-8bee2d5ef04e",
        "type": "custom",
        "disabled": false,
        "negate": false,
        "alias": null,
        "key": "query",
        "value": "{\"bool\":{\"minimum_should_match\":1,\"should\":[{\"match_phrase\":{\"kibana.alert.severity\":\"critical\"}},{\"match_phrase\":{\"kibana.alert.severity\":\"high\"}},{\"match_phrase\":{\"kibana.alert.severity\":\"medium\"}}]}}"
      },
      "$state": {
        "store": "appState"
      },
      "query": {
        "bool": {
          "minimum_should_match": 1,
          "should": [
            {
              "match_phrase": {
                "kibana.alert.severity": "critical"
              }
            },
            {
              "match_phrase": {
                "kibana.alert.severity": "high"
              }
            },
            {
              "match_phrase": {
                "kibana.alert.severity": "medium"
              }
            }
          ]
        }
      }
    }
  ]
}