  "query": "FROM logs-* | WHERE event.code == \"4740\" \r\n| WHERE user.name NOT LIKE \"*$\" AND user.name NOT LIKE \"svc_*\"\r\n| STATS lockout_count = count() BY user.name, host.name \r\n| WHERE lockout_count > 10",
