{
  "name": "Malicious PowerShell Process - Encoded Command",
  "tags": [],
  "interval": "5m",
  "enabled": true,
  "description": "Detects PowerShell with encoded commands",
  "risk_score": 99,
  "severity": "critical",
  "license": "",
  "output_index": "",
  "meta": {
    "kibana_siem_app_url": "https://nbi.scanwave.local:8008/app/security"
  },
  "investigation_fields": {
    "field_names": [
      "user.name",
      "process.name",
      "process.parent.name",
      "process.command_line",
      "host.name"
    ]
  },
  "author": [],
  "false_positives": [],
  "from": "now-15m",
  "rule_id": "d009cbed-d0ed-4f30-a177-bca2f5bbee67",
  "max_signals": 100,
  "risk_score_mapping": [],
  "severity_mapping": [],
  "threat": [],
  "to": "now",
  "references": [],
  "version": 1,
  "exceptions_list": [],
  "related_integrations": [],
  "required_fields": [],
  "setup": "",
  "type": "query",
  "language": "kuery",
  "data_view_id": "logs-*",
  "query": "process.name : \"powershell.exe\" AND process.args : (\"-EncodedCommand\" OR \"-enc\")",
  "filters": [
    {
      "meta": {
        "index": "logs-*",
        "type": "phrase",
        "disabled": false,
        "negate": true,
        "alias": null,
        "key": "process.parent.executable",
        "params": {
          "query": "C:\\Program Files\\Nutanix\\Python36\\python.exe"
        }
      },
      "query": {
        "match_phrase": {
          "process.parent.executable": "C:\\Program Files\\Nutanix\\Python36\\python.exe"
        }
      },
      "$state": {
        "store": "appState"
      }
    }
  ],
  "actions": []
}